// Utilitários para num / bool

func abs(num x) num {
  if x < 0 {
    return 0 - x;
  } else {
    return x;
  }
}

func max(num a, num b) num {
  if a > b {
    return a;
  } else {
    return b;
  }
}

func min(num a, num b) num {
  if a < b {
    return a;
  } else {
    return b;
  }
}

func sign(num x) num {
  if x > 0 {
    return 1;
  } else {
    if x < 0 {
      return 0 - 1;
    } else {
      return 0;
    }
  }
}

func clamp(num x, num lo, num hi) num {
  if x < lo {
    return lo;
  } else {
    if x > hi {
      return hi;
    } else {
      return x;
    }
  }
}

func pow(num base, num exp) num {
  num result = 1;
  num i = 0;
  while i < exp {
    result = result * base;
    i++;
  }
  return result;
}

func isEven(num x) bool {
  return x % 2 == 0;
}

func isOdd(num x) bool {
  return x % 2 == 1;
}

func xor(bool a, bool b) bool {
  return (a or b) and not (a and b);
}

func factorial(num n) num {
  num result = 1;
  num i = 1;
  while i <= n {
    result = result * i;
    i++;
  }
  return result;
}

func printNum(num x) num {
  print x;
  return x;
}

func printBool(bool x) num {
  if x {
    print 1;
  } else {
    print 0;
  }
  return 0;
}
